FROM ghcr.io/sparfenyuk/mcp-proxy:latest

# Install docker CLI so the proxy can spawn docker containers

RUN apk add --no-cache docker-cli

# Install uv using pip (recommended by mcp-proxy docs)
RUN python3 -m ensurepip && pip install --no-cache-dir uv

ENV UV_PYTHON_PREFERENCE=only-system

COPY --chmod=755 docker-run-with-secrets.sh /usr/local/bin/docker-run-with-secrets

ENTRYPOINT ["mcp-proxy"]
