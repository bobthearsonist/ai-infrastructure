# SonarQube MCP Server — SonarCloud credentials
# Copy to `.env` (gitignored) and fill in, OR export these in your shell
# before `docker compose up`. Do NOT commit real tokens.

# Generate at: https://sonarcloud.io/account/security  (User token)
SONARQUBE_TOKEN=

# SonarCloud organization key. Defaults to `profisee` if unset.
# SONARQUBE_ORG=profisee
