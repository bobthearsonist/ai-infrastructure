{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/graphify-reminder.sh search",
            "powershell": "$ErrorActionPreference = 'Stop'; bash -- .claude/hooks/graphify-reminder.sh search; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/graphify-reminder.sh read",
            "powershell": "$ErrorActionPreference = 'Stop'; bash -- .claude/hooks/graphify-reminder.sh read; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
